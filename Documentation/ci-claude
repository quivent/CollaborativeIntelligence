#!/bin/bash
# ci-claude - Claude CLI wrapper with CollaborativeIntelligence support
# Version: 1.0.0

# Default settings
CI_REPO="https://github.com/joshkornreich/CollaborativeIntelligence.git"
CI_DIR="CollaborativeIntelligence"
CI_PARENT_DIR="$(dirname "$(pwd)")"
CI_SIBLING_DIR="$CI_PARENT_DIR/CollaborativeIntelligence"
CI_ACTUAL_PATH="/Users/joshkornreich/Documents/Projects/CollaborativeIntelligence"
CONFIG_FILE=".collaborative-intelligence.json"
WITH_CI=false
INTERACTIVE=false
SIBLING=false
COMMAND=""

# ANSI color codes
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

# Print banner
print_banner() {
  echo -e "${BLUE}====================================${NC}"
  echo -e "${BLUE}  CollaborativeIntelligence System  ${NC}"
  echo -e "${BLUE}====================================${NC}"
  echo
}

# Show help
show_help() {
  echo "Usage: ci-claude [command] [options]"
  echo
  echo "A wrapper for the Claude CLI that adds CollaborativeIntelligence support."
  echo
  echo "Commands:"
  echo "  init                Initialize a new project"
  echo "  (any claude command) Passed directly to claude CLI"
  echo
  echo "Options:"
  echo "  -ci, --with-ci      Initialize with CollaborativeIntelligence system"
  echo "  -i, --interactive   Enable interactive setup with prompts"
  echo "  -s, --sibling       Set up CI as sibling directory (recommended)"
  echo "  -h, --help          Show this help message"
  echo
  echo "Examples:"
  echo "  ci-claude init              Regular claude init"
  echo "  ci-claude init -ci          Init with CollaborativeIntelligence"
  echo "  ci-claude init -ci -i       Interactive CI setup"
  echo "  ci-claude init -ci -s       Set up CI as sibling directory"
  echo
}

# Parse command line arguments
parse_args() {
  while [[ $# -gt 0 ]]; do
    case $1 in
      init)
        COMMAND="init"
        shift
        ;;
      -ci|--with-ci)
        WITH_CI=true
        shift
        ;;
      -i|--interactive)
        INTERACTIVE=true
        shift
        ;;
      -s|--sibling)
        SIBLING=true
        shift
        ;;
      -h|--help)
        show_help
        exit 0
        ;;
      *)
        # Pass through to claude
        ARGS+=("$1")
        shift
        ;;
    esac
  done
}

# Get project information interactively
get_project_info() {
  print_banner
  
  # Project name (default to current directory)
  CURRENT_DIR=$(basename "$(pwd)")
  read -p "Project name [$CURRENT_DIR]: " PROJECT_NAME
  PROJECT_NAME=${PROJECT_NAME:-$CURRENT_DIR}
  
  # Try to detect language based on files
  DEFAULT_LANG="Unknown"
  if [ -f "Package.swift" ]; then
    DEFAULT_LANG="Swift"
  elif [ -f "pom.xml" ]; then
    DEFAULT_LANG="Java"
  elif [ -f "package.json" ]; then
    DEFAULT_LANG="JavaScript/TypeScript"
  elif [ -f "go.mod" ]; then
    DEFAULT_LANG="Go"
  elif [ -f "requirements.txt" ] || [ -f "setup.py" ]; then
    DEFAULT_LANG="Python"
  fi
  
  read -p "Primary language/framework [$DEFAULT_LANG]: " PROJECT_LANG
  PROJECT_LANG=${PROJECT_LANG:-$DEFAULT_LANG}
  
  read -p "Project description: " PROJECT_DESC
  
  echo
  echo -e "${GREEN}Configuring CollaborativeIntelligence for:${NC}"
  echo -e "Name: ${YELLOW}$PROJECT_NAME${NC}"
  echo -e "Language: ${YELLOW}$PROJECT_LANG${NC}"
  echo -e "Description: ${YELLOW}$PROJECT_DESC${NC}"
  echo
}

# Setup CollaborativeIntelligence
setup_ci() {
  echo -e "${GREEN}Setting up CollaborativeIntelligence system...${NC}"
  
  # Determine target directory based on sibling flag
  TARGET_DIR="$CI_DIR"
  CONFIG_PATH="$CI_DIR"
  
  # Check if we're already in the actual CollaborativeIntelligence repo
  if [ "$(pwd)" = "$CI_ACTUAL_PATH" ]; then
    TARGET_DIR="$(pwd)"
    CONFIG_PATH="."
  elif [ "$SIBLING" = true ]; then
    TARGET_DIR="$CI_SIBLING_DIR"
    CONFIG_PATH="../CollaborativeIntelligence"
    
    # Create sibling directory if it doesn't exist
    if [ ! -d "$TARGET_DIR" ]; then
      echo -e "${BLUE}Creating sibling directory at $TARGET_DIR${NC}"
      mkdir -p "$TARGET_DIR"
    else
      echo -e "${YELLOW}Sibling directory already exists. Using existing directory.${NC}"
    fi
    
    # Create symlink if requested
    if [ ! -L "$CI_DIR" ]; then
      echo -e "${BLUE}Creating symbolic link from project to sibling directory${NC}"
      ln -s "$TARGET_DIR" "$CI_DIR"
    fi
  else
    # Using embedded directory
    mkdir -p "$TARGET_DIR"
  fi
  
  # Create directory structure
  mkdir -p "$TARGET_DIR/AGENTS"
  mkdir -p "$TARGET_DIR/Sessions"
  mkdir -p "$TARGET_DIR/Documentation"
  
  # Create agent directories
  mkdir -p "$TARGET_DIR/AGENTS/Athena/Sessions"
  mkdir -p "$TARGET_DIR/AGENTS/AgentRecommender/Sessions"
  mkdir -p "$TARGET_DIR/AGENTS/ProjectOverviewer/Sessions"
  mkdir -p "$TARGET_DIR/AGENTS/CodeCartographer/Sessions"
  
  # Create configuration file
  create_config_file "$CONFIG_PATH"
  
  # Create QuickStart file
  create_quickstart_file "$TARGET_DIR"
  
  # Create CLAUDE.md
  create_claude_md "$TARGET_DIR"
  
  echo -e "${GREEN}CollaborativeIntelligence system initialized!${NC}"
  echo
  echo -e "You can now use:"
  echo -e "- ${YELLOW}\"Athena\"${NC} - Your learning systems expert"
  echo -e "- ${YELLOW}\"Recommend an agent\"${NC} - Find the right agent for your task"
  echo -e "- ${YELLOW}\"Project Overview\"${NC} - See what's in this repository"
  echo -e "- ${YELLOW}\"Detailed Analysis\"${NC} - Get comprehensive documentation"
  echo
  if [ "$SIBLING" = true ]; then
    echo -e "CollaborativeIntelligence is set up as a ${GREEN}sibling directory${NC} at:"
    echo -e "${BLUE}$TARGET_DIR${NC}"
    echo -e "with a symbolic link from your project."
  else
    echo -e "CollaborativeIntelligence is ${GREEN}embedded${NC} in your project."
  fi
  echo
  echo -e "See ${BLUE}$CI_DIR/docs/guides/QuickStart.md${NC} for details."
  echo
}

# Create config file
create_config_file() {
  local config_path=${1:-"$CI_DIR"}
  
  if [ "$INTERACTIVE" = true ]; then
    PROJECT_TYPE="application"
    if [ -z "$PROJECT_NAME" ]; then
      PROJECT_NAME=$(basename "$(pwd)")
    fi
    if [ -z "$PROJECT_LANG" ]; then
      PROJECT_LANG="Unknown"
    fi
  else
    PROJECT_NAME=$(basename "$(pwd)")
    PROJECT_LANG="Unknown"
    PROJECT_DESC="A project using the CollaborativeIntelligence system"
    PROJECT_TYPE="application"
  fi
  
  # Determine integration type
  local integration_type="embedded"
  local repo_path="./$CI_DIR"
  
  if [ "$SIBLING" = true ]; then
    integration_type="sibling"
    repo_path="$config_path"
  fi
  
  cat > "$CONFIG_FILE" << EOF
{
  "integration_type": "$integration_type",
  "repository_path": "$repo_path",
  "active_agents": ["Athena", "AgentRecommender", "ProjectOverviewer", "CodeCartographer"],
  "fast_activation": true,
  "preload_context": true,
  "fast_activation_config": {
    "token_limit": 20,
    "target_response_time": 5.0,
    "priority_agents": ["Athena"]
  },
  "project_info": {
    "name": "$PROJECT_NAME",
    "type": "$PROJECT_TYPE",
    "primary_language": "$PROJECT_LANG",
    "description": "$PROJECT_DESC"
  },
  "repository_options": {
    "current": "$integration_type",
    "recommended": "sibling",
    "sibling_path": "../CollaborativeIntelligence",
    "absolute_path": "$CI_ACTUAL_PATH",
    "symlink_source": "$CI_SIBLING_DIR"
  },
  "version": "1.0.0"
}
EOF
}

