# Create CLAUDE.md
create_claude_md() {
  local target_dir=${1:-"$CI_DIR"}
  cat > "$target_dir/CLAUDE.md" << 'EOF'
# Collaborative Intelligence System - Configuration

This file serves as the primary configuration and initialization point for the Collaborative Intelligence System.

## Quick Start

| Type this in terminal | To get this |
|----------------------|-------------|
| `Athena` | Your memory & learning systems expert (✦ PRIMARY AGENT) |
| `Recommend an agent` | Find the perfect agent for your specific task |
| `Project Overview` | See what's in this repository right now |
| `Detailed Analysis` | Get comprehensive codebase documentation |

For complete details, see `CollaborativeIntelligence/docs/guides/QuickStart.md`

## System Initialization

When starting a new session with this system, Claude will:

1. Load this file first to understand the collaboration framework
2. Process the collaborative intelligence architecture and memory systems
3. Initialize the appropriate specialized agent based on the context
4. Access relevant memory structures for continuity

## Collaboration Framework

The Collaborative Intelligence System transforms traditional AI assistance into a persistent, learning ecosystem with specialized components working together. This system maintains knowledge across sessions through structured external storage while enabling specialized expertise through dedicated agent roles.

## Memory Management

Each interaction within the system contributes to three levels of knowledge:

1. **Session Records**: Complete documentation of the specific interaction
2. **Continuous Learning**: Extracted principles and patterns from interactions
3. **Memory Integration**: Core knowledge that forms agent identity and expertise

These tiers ensure efficient knowledge retention with progressive refinement.
EOF
}

# Copy CI to sibling directory
copy_to_sibling() {
  if [ -d "$CI_DIR" ] && [ ! -L "$CI_DIR" ]; then
    echo -e "${BLUE}Copying existing CollaborativeIntelligence to sibling directory...${NC}"
    
    # Create parent directory if needed
    mkdir -p "$CI_SIBLING_DIR"
    
    # Copy files
    cp -r "$CI_DIR"/* "$CI_SIBLING_DIR"/
    
    # Create symlink back
    echo -e "${BLUE}Creating symbolic link to sibling directory...${NC}"
    rm -rf "$CI_DIR"
    ln -s "$CI_SIBLING_DIR" "$CI_DIR"
    
    echo -e "${GREEN}Successfully converted to sibling directory architecture!${NC}"
  else
    echo -e "${YELLOW}Nothing to copy. Will create new sibling directory.${NC}"
  fi
}

# Main function
main() {
  parse_args "$@"
  
  if [ "$COMMAND" = "init" ]; then
    # First run the standard claude init
    claude init "${ARGS[@]}"
    
    # Then add CI if requested
    if [ "$WITH_CI" = true ]; then
      if [ "$SIBLING" = true ]; then
        # If sibling flag is set and CI already exists, copy it to sibling dir
        if [ -d "$CI_DIR" ] && [ ! -L "$CI_DIR" ]; then
          copy_to_sibling
        fi
      fi
      
      if [ "$INTERACTIVE" = true ]; then
        get_project_info
      fi
      
      setup_ci
    fi
  else
    # Pass through to claude
    claude "$COMMAND" "${ARGS[@]}"
  fi
}

# Execute main function
main "$@"