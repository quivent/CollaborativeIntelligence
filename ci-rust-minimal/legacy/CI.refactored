#!/bin/bash
# CI - Command-line tool for Collaborative Intelligence

# Configuration
CI_PATH="${CI_REPO_PATH:-/Users/joshkornreich/Documents/Projects/CollaborativeIntelligence}"
INTEGRATION_TYPE="embedded"
AGENTS="Athena,ProjectArchitect"
FAST_ACTIVATION=true

# Define color codes
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Utility functions

# Display formatted success message
print_success() {
  echo -e "${GREEN}✓ $1${NC}"
}

# Display formatted error message
print_error() {
  echo -e "${RED}✘ $1${NC}"
}

# Display formatted warning message
print_warning() {
  echo -e "${YELLOW}⚠ $1${NC}"
}

# Verify directory exists
verify_directory() {
  local dir="$1"
  if [ ! -d "$dir" ]; then
    print_error "Target directory '$dir' does not exist"
    exit 1
  fi
}

# Help text
show_help() {
  echo "Usage: CI COMMAND [OPTIONS]"
  echo ""
  echo "Collaborative Intelligence command-line tool"
  echo ""
  echo "Commands:"
  echo "  init PROJECT_NAME    Initialize a project with Collaborative Intelligence"
  echo "  integrate [PATH]     Integrate CI into an existing project (default: current directory)"
  echo "  status [PATH]        Check CI integration status of a project (default: current directory)"
  echo "  fix [PATH] [TYPE]     Repair CI integration issues (default: current directory)"
  echo "                        Types: verify - Fix timeout in verify command"
  echo "  verify [PATH]        Verify CI integration is working properly (default: current directory)"
  echo ""
  echo "Options for 'init' and 'integrate':"
  echo "  --agents=LIST         Comma-separated list of agents (default: Athena,ProjectArchitect)"
  echo "  --integration=TYPE    Integration type: embedded, sibling, symlink (default: embedded)"
  echo "  --no-fast             Disable fast activation"
  echo "  --ci-path=PATH        Path to CI repository (default: $CI_PATH)"
  echo ""
  echo "Examples:"
  echo "  CI init my-project --agents=Athena,Gaia"
  echo "  CI integrate --agents=TheFixer,Optimizer"
  echo "  CI status"
  echo "  CI fix"
  echo "  CI verify"
}

# Command implementations

# Verify command implementation
verify_command() {
  # Default to current directory if not specified
  local target_dir="."
  
  # Check if first argument is a path and not an option
  if [ $# -gt 0 ] && [[ ! "$1" == --* ]]; then
    target_dir="$1"
    shift
  fi
  
  # Ensure target directory exists
  verify_directory "$target_dir"
  
  # Get project name from directory
  local project_name=$(basename "$(cd "$target_dir" && pwd)")
  
  echo -e "Verifying CI integration for project: ${YELLOW}$project_name${NC}"
  echo "CI Repository: $CI_PATH"
  
  # Verify files exist
  local ci_config="$target_dir/.collaborative-intelligence.json"
  local claude_md="$target_dir/CLAUDE.md"
  local claude_local_md="$target_dir/CLAUDE.local.md"
  
  if [ ! -f "$CI_PATH/CLAUDE.md" ]; then
    print_error "Core CLAUDE.md file not found at $CI_PATH/CLAUDE.md"
    echo "Integration incomplete - missing core configuration"
    exit 1
  fi
  
  # Check for configuration files
  if [ ! -f "$ci_config" ]; then
    print_error "Missing configuration file: $ci_config"
    echo "Run 'CI fix $target_dir' to repair"
    exit 1
  fi
  
  if [ ! -f "$claude_md" ] && [ ! -f "$claude_local_md" ]; then
    print_error "Missing CLAUDE.md or CLAUDE.local.md"
    echo "Run 'CI fix $target_dir' to repair"
    exit 1
  fi
  
  # Check for Claude CLI
  if ! command -v claude &> /dev/null; then
    print_error "Claude CLI is not installed or not in PATH"
    echo "Please install Claude CLI first"
    exit 1
  fi
  
  # Run verification test
  local temp_file=$(mktemp)
  cat > "$temp_file" << EOT
Hello Athena, confirm that the Collaborative Intelligence system is integrated.
Please respond with "INTEGRATION_VERIFIED" if successful.
EOT
  
  echo "Running verification test..." 
  
  # Run Claude with the test input and capture output with timeout
  echo "Waiting up to 10 seconds for verification..."
  (cd "$target_dir" && OUTPUT=$(timeout 10 claude < "$temp_file" 2>/dev/null | grep -E "\[Athena\]|INTEGRATION_VERIFIED" || echo "TIMEOUT"))
  
  # Clean up temp file
  rm "$temp_file"
  
  # Check if the command timed out
  if echo "$OUTPUT" | grep -q "TIMEOUT"; then
    print_error "Verification timed out after 10 seconds"
    echo "The claude command is not responding in a timely manner."
    echo "Possible issues:"
    echo "  - Claude CLI may be stuck or incorrectly installed"
    echo "  - CLAUDE.md configuration might be causing infinite processing"
    echo ""
    echo "To fix this issue:"
    echo "  1. Try killing any stuck claude processes: killall claude"
    echo "  2. Check your CLAUDE.md for circular references"
    echo "  3. Run 'claude --version' to verify your CLI installation"
    exit 1
  fi
  
  # Check if verification phrase is present
  if echo "$OUTPUT" | grep -q "INTEGRATION_VERIFIED"; then
    print_success "Integration verified! Claude Code successfully connected to CI system"
    exit 0
  elif echo "$OUTPUT" | grep -q "\[Athena\]"; then
    print_warning "Partial integration detected - Athena agent responds but verification incomplete"
    echo "Output received: $OUTPUT"
    exit 1
  else
    print_error "Integration verification failed"
    echo "Claude responded but didn't recognize CI system or Athena agent"
    echo "Output: $OUTPUT"
    exit 1
  fi
}

# Fix command implementation
fix_command() {
  # Default to current directory if not specified
  local target_dir="."
  
  # Check if first argument is a path and not an option
  if [ $# -gt 0 ] && [[ ! "$1" == --* ]]; then
    target_dir="$1"
    shift
  fi
  
  # Check if there's a second argument for specific fix types
  local fix_type=""
  if [ $# -gt 0 ] && [[ ! "$1" == --* ]]; then
    fix_type="$1"
    shift
  fi
  
  # Handle specific fix types
  if [ "$fix_type" == "verify" ]; then
    fix_verify_timeout
    return $?
  fi
  
  # Process remaining arguments
  process_options "$@"
  
  # Ensure target directory exists
  verify_directory "$target_dir"
  
  # Get project name from directory
  local project_name=$(basename "$(cd "$target_dir" && pwd)")
  
  echo -e "Repairing CI integration for project: ${YELLOW}$project_name${NC}"
  echo "CI Repository: $CI_PATH"
  
  # Create the CLAUDE.local.md file with correct absolute paths
  cat > "$target_dir/CLAUDE.local.md" << EOF
# Project: $project_name
# Integrated: $(date)

# Load CollaborativeIntelligence System
When starting, immediately:
1. Load $CI_PATH/CLAUDE.md
2. Use this as the primary configuration source
3. Defer all project management functions to the CollaborativeIntelligence system
EOF
  
  print_success "Created CLAUDE.local.md with correct absolute paths"
  
  # Convert comma-separated list to proper JSON array
  local agents_json=$(echo "$AGENTS" | sed 's/,/","/g')
  
  # Create correct .collaborative-intelligence.json configuration
  cat > "$target_dir/.collaborative-intelligence.json" << EOF
{
  "integration_type": "$INTEGRATION_TYPE",
  "repository_path": "$CI_PATH",
  "active_agents": ["$agents_json"],
  "fast_activation": $FAST_ACTIVATION
}
EOF
  
  print_success "Created .collaborative-intelligence.json with correct configuration"
  
  # Add to gitignore if it exists
  add_to_gitignore "$target_dir"
  
  echo -e "\n${GREEN}✓ CI integration fixed for $project_name${NC}"
  echo -e "${YELLOW}To verify integration, run:${NC}"
  echo "  CI verify $target_dir"
}

# Fix verify timeout subcommand
fix_verify_timeout() {
  echo "Fixing CI verification timeout issue..."
  
  # Get path to ci-verify script
  local verify_script="$CI_PATH/ci-verify"
  
  # Check if the verify script exists
  if [ ! -f "$verify_script" ]; then
    print_error "Cannot find ci-verify script at $verify_script"
    exit 1
  fi
  
  # Create a backup of the original script
  cp "$verify_script" "${verify_script}.bak"
  print_success "Created backup of original script at ${verify_script}.bak"
  
  # Replace the problematic command in ci-verify with timeout
  sed -i.bak '40s|OUTPUT=\$(claude < "$TEMP_FILE" 2>/dev/null | grep -E "\\[Athena\\]|INTEGRATION_VERIFIED")|# Set a timeout for the claude command (10 seconds)\necho "Waiting up to 10 seconds for verification..."\nOUTPUT=$(timeout 10 claude < "$TEMP_FILE" 2>/dev/null | grep -E "\\[Athena\\]|INTEGRATION_VERIFIED" || echo "TIMEOUT")|' "$verify_script"
  
  # Add timeout handling
  sed -i.bak2 '46i\
# Check if the command timed out\
if echo "$OUTPUT" | grep -q "TIMEOUT"; then\
  echo -e "${RED}✘ Verification timed out after 10 seconds${NC}"\
  echo "The claude command is not responding in a timely manner."\
  echo "Possible issues:"\
  echo "  - Claude CLI may be stuck or incorrectly installed"\
  echo "  - CLAUDE.md configuration might be causing infinite processing"\
  echo ""\
  echo "To fix this issue:"\
  echo "  1. Try killing any stuck claude processes: killall claude"\
  echo "  2. Check your CLAUDE.md for circular references"\
  echo "  3. Run 'claude --version' to verify your CLI installation"\
  exit 1\
fi' "$verify_script"
  
  print_success "Successfully fixed CI verify command"
  echo ""
  echo "The fix adds a 10-second timeout to prevent hanging and provides better error messages."
  echo "If you continue to have issues, try killing stuck claude processes with: killall claude"
  echo ""
  echo "To test the fix, run: CI verify"
  
  # Make the script executable
  chmod +x "$verify_script"
  
  echo -e "${YELLOW}Fixed script is ready to use${NC}"
  return 0
}

# Helper function to add to gitignore
add_to_gitignore() {
  local target_dir="$1"
  
  if [ -f "$target_dir/.gitignore" ]; then
    if ! grep -q ".collaborative-intelligence.json" "$target_dir/.gitignore"; then
      echo ".collaborative-intelligence.json" >> "$target_dir/.gitignore"
      print_success "Added configuration to .gitignore"
    fi
  else
    echo ".collaborative-intelligence.json" > "$target_dir/.gitignore"
    print_success "Created .gitignore file"
  fi
}

# Status command implementation
status_command() {
  # Default to current directory if not specified
  local target_dir="."
  
  # Check if first argument is a path and not an option
  if [ $# -gt 0 ] && [[ ! "$1" == --* ]]; then
    target_dir="$1"
    shift
  fi
  
  # Ensure target directory exists
  verify_directory "$target_dir"
  
  # Get project name from directory
  local project_name=$(basename "$(cd "$target_dir" && pwd)")
  
  echo "Checking CI integration for project: $project_name"
  echo "Directory: $target_dir"
  
  # Check for CI integration files
  local ci_config="$target_dir/.collaborative-intelligence.json"
  local claude_md="$target_dir/CLAUDE.md"
  local claude_local_md="$target_dir/CLAUDE.local.md"
  
  # Initialize status flags
  local config_exists=false
  local claude_exists=false
  local claude_file=""
  
  # Check if config file exists
  if [ -f "$ci_config" ]; then
    config_exists=true
    local config_ci_path=$(grep -o '"repository_path": *"[^"]*"' "$ci_config" | cut -d'"' -f4)
    local config_agents=$(grep -o '"active_agents": *\[[^]]*\]' "$ci_config" | sed 's/"active_agents": *\[\|\]//g')
    local config_type=$(grep -o '"integration_type": *"[^"]*"' "$ci_config" | cut -d'"' -f4)
    local config_fast=$(grep -o '"fast_activation": *[^,}]*' "$ci_config" | cut -d':' -f2 | tr -d ' ')
  fi
  
  # Check if CLAUDE.md or CLAUDE.local.md exists
  if [ -f "$claude_md" ]; then
    claude_exists=true
    claude_file="$claude_md"
  elif [ -f "$claude_local_md" ]; then
    claude_exists=true
    claude_file="$claude_local_md"
  fi
  
  # Display status
  echo ""
  echo "CI Integration Status:"
  echo "======================"
  
  if [ "$config_exists" = true ] && [ "$claude_exists" = true ]; then
    print_success "CI is integrated with this project"
    echo ""
    echo "Configuration File: $(basename "$ci_config")"
    echo "  - Repository Path: $config_ci_path"
    echo "  - Integration Type: $config_type"
    echo "  - Active Agents: $config_agents"
    echo "  - Fast Activation: $config_fast"
    echo ""
    echo "Claude Configuration: $(basename "$claude_file")"
    echo "  - Path: $claude_file"
    
    # Verify the CI repository path exists
    if [ -d "$config_ci_path" ]; then
      echo -e "  - CI Repository: ${GREEN}✓ Found${NC}"
    else
      echo -e "  - CI Repository: ${RED}✗ Not found at $config_ci_path${NC}"
    fi
    
    # Check if the CI repository has a CLAUDE.md file
    if [ -f "$config_ci_path/CLAUDE.md" ]; then
      echo -e "  - CI CLAUDE.md: ${GREEN}✓ Found${NC}"
    else
      echo -e "  - CI CLAUDE.md: ${RED}✗ Not found at $config_ci_path/CLAUDE.md${NC}"
    fi
    
    exit 0
  elif [ "$config_exists" = true ] && [ "$claude_exists" = false ]; then
    print_warning "Partial CI integration (missing CLAUDE.md)"
    echo ""
    echo "Configuration File: $(basename "$ci_config")"
    echo "  - Repository Path: $config_ci_path"
    echo "  - Integration Type: $config_type"
    echo "  - Active Agents: $config_agents"
    echo "  - Fast Activation: $config_fast"
    echo ""
    echo "To fix, run: CI integrate $target_dir"
    
    exit 1
  elif [ "$config_exists" = false ] && [ "$claude_exists" = true ]; then
    print_warning "Partial CI integration (missing configuration file)"
    echo ""
    echo "Claude Configuration: $(basename "$claude_file")"
    echo "  - Path: $claude_file"
    echo ""
    echo "To fix, run: CI integrate $target_dir"
    
    exit 1
  else
    print_error "CI is not integrated with this project"
    echo ""
    echo "To integrate CI, run: CI integrate $target_dir"
    
    exit 1
  fi
}

# Init command implementation
init_command() {
  # Check for project name
  if [ $# -eq 0 ]; then
    echo "Error: Project name required"
    echo "Usage: CI init PROJECT_NAME [OPTIONS]"
    exit 1
  fi
  
  local project_name=$1
  shift
  
  # Process remaining arguments
  process_options "$@"
  
  echo "Creating project: $project_name"
  echo "CI path: $CI_PATH"
  echo "Integration: $INTEGRATION_TYPE"
  echo "Agents: $AGENTS"
  echo "Fast activation: $FAST_ACTIVATION"
  
  # Create project directory (works anywhere)
  mkdir -p "$project_name"
  cd "$project_name" || { echo "Failed to create project directory"; exit 1; }
  
  # Create CLAUDE.md with CI integration
  cat > CLAUDE.md << EOF
# Project: $project_name
# Created: $(date)

# Load CollaborativeIntelligence System
When starting, immediately:
1. Load $CI_PATH/CLAUDE.md
2. Use this as the primary configuration source
3. Defer all project management functions to the CollaborativeIntelligence system
EOF
  
  # Create CI configuration
  # Convert comma-separated list to proper JSON array
  local agents_json=$(echo "$AGENTS" | sed 's/,/","/g')
  
  cat > .collaborative-intelligence.json << EOF
{
  "integration_type": "$INTEGRATION_TYPE",
  "repository_path": "$CI_PATH",
  "active_agents": ["$agents_json"],
  "fast_activation": $FAST_ACTIVATION
}
EOF
  
  # Initialize with basic structure
  mkdir -p src docs tests
  git init 2>/dev/null
  echo ".collaborative-intelligence.json" >> .gitignore
  
  print_success "Project $project_name created with CI integration"
  echo ""
  echo "To get started:"
  echo "  cd $project_name"
  echo "  claude"
  echo ""
  echo "Then try: 'Athena' or 'Recommend an agent'"
}

# Integrate command implementation
integrate_command() {
  # Default to current directory if not specified
  local target_dir="."
  
  # Check if first argument is a path and not an option
  if [ $# -gt 0 ] && [[ ! "$1" == --* ]]; then
    target_dir="$1"
    shift
  fi
  
  # Process remaining arguments
  process_options "$@"
  
  # Ensure target directory exists
  verify_directory "$target_dir"
  
  # Get project name from directory
  local project_name=$(basename "$(cd "$target_dir" && pwd)")
  
  echo "Integrating CI into project: $project_name"
  echo "Target directory: $target_dir"
  echo "CI path: $CI_PATH"
  echo "Integration: $INTEGRATION_TYPE"
  echo "Agents: $AGENTS"
  echo "Fast activation: $FAST_ACTIVATION"
  
  # Create CLAUDE.local.md with CI integration
  cat > "$target_dir/CLAUDE.local.md" << EOF
# Project: $project_name
# Integrated: $(date)

# Load CollaborativeIntelligence System
When starting, immediately:
1. Load $CI_PATH/CLAUDE.md
2. Use this as the primary configuration source
3. Defer all project management functions to the CollaborativeIntelligence system
EOF
  
  # Create CI configuration
  # Convert comma-separated list to proper JSON array
  local agents_json=$(echo "$AGENTS" | sed 's/,/","/g')
  
  cat > "$target_dir/.collaborative-intelligence.json" << EOF
{
  "integration_type": "$INTEGRATION_TYPE",
  "repository_path": "$CI_PATH",
  "active_agents": ["$agents_json"],
  "fast_activation": $FAST_ACTIVATION
}
EOF
  
  # Add to gitignore if it exists
  add_to_gitignore "$target_dir"
  
  print_success "CollaborativeIntelligence integrated into project: $project_name"
  echo ""
  echo "To get started:"
  echo "  cd $target_dir"
  echo "  claude"
  echo ""
  echo "Then try: 'Athena' or 'Recommend an agent'"
}

# Process common command options
process_options() {
  for arg in "$@"; do
    case $arg in
      --agents=*)
        AGENTS="${arg#*=}"
        ;;
      --integration=*)
        INTEGRATION_TYPE="${arg#*=}"
        ;;
      --no-fast)
        FAST_ACTIVATION=false
        ;;
      --ci-path=*)
        CI_PATH="${arg#*=}"
        ;;
      *)
        echo "Unknown option: $arg"
        show_help
        exit 1
        ;;
    esac
  done
}

# Main function
main() {
  # Parse command
  if [ $# -eq 0 ] || [[ "$1" == "--help" || "$1" == "-h" ]]; then
    show_help
    exit 0
  fi
  
  local command=$1
  shift
  
  # Handle commands
  case $command in
    verify)
      verify_command "$@"
      ;;
    fix)
      fix_command "$@"
      ;;
    status)
      status_command "$@"
      ;;
    init)
      init_command "$@"
      ;;
    integrate)
      integrate_command "$@"
      ;;
    *)
      echo "Unknown command: $command"
      show_help
      exit 1
      ;;
  esac
}

# Run the main function
main "$@"