{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory CLI Schemas",
  "description": "JSON schemas for the Memory CLI tool data exchange formats",
  "definitions": {
    "AgentCacheEntry": {
      "type": "object",
      "description": "Represents an agent activation record",
      "required": ["agent_name", "directory", "initializer", "timestamp", "intent", "status"],
      "properties": {
        "agent_name": {
          "type": "string",
          "description": "Name of the agent"
        },
        "directory": {
          "type": "string",
          "description": "Working directory where the agent was activated"
        },
        "initializer": {
          "type": "string",
          "description": "Entity or command that activated the agent"
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp of activation time"
        },
        "intent": {
          "type": "string",
          "description": "Purpose of activation"
        },
        "status": {
          "type": "string",
          "enum": ["Active", "Inactive"],
          "description": "Current agent status"
        }
      }
    },
    "MemorySegment": {
      "type": "object",
      "description": "Represents a piece of agent memory",
      "required": ["id", "memory_type", "tier", "domains", "content", "source_file"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the memory segment"
        },
        "memory_type": {
          "type": "string",
          "enum": ["Semantic", "Procedural", "Episodic", "Core"],
          "description": "Type of memory"
        },
        "tier": {
          "type": "string",
          "enum": ["Tier1", "Tier2", "Tier3"],
          "description": "Memory priority tier"
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Knowledge domains this segment belongs to"
        },
        "content": {
          "type": "string",
          "description": "Actual memory content"
        },
        "source_file": {
          "type": "string",
          "description": "Source file where this memory originated"
        },
        "line_start": {
          "type": "integer",
          "description": "Starting line in source file"
        },
        "line_end": {
          "type": "integer",
          "description": "Ending line in source file"
        },
        "last_accessed": {
          "type": "integer",
          "description": "Unix timestamp of last access time"
        },
        "access_count": {
          "type": "integer",
          "description": "Number of times this segment has been accessed"
        },
        "metadata": {
          "type": "object",
          "description": "Additional properties"
        }
      }
    },
    "ChecksumEntry": {
      "type": "object",
      "description": "Represents a checksum for a memory file",
      "required": ["file_path", "checksum", "last_checked", "segments_checksums"],
      "properties": {
        "file_path": {
          "type": "string",
          "description": "Path to the memory file"
        },
        "checksum": {
          "type": "string",
          "description": "MD5 checksum of the entire file"
        },
        "last_checked": {
          "type": "integer",
          "description": "Unix timestamp of last check time"
        },
        "segments_checksums": {
          "type": "object",
          "description": "Map of segment ID to checksum",
          "additionalProperties": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object",
          "description": "Additional properties"
        }
      }
    },
    "CliResponse": {
      "type": "object",
      "description": "Standard response format for CLI operations",
      "required": ["success", "message", "timestamp"],
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Indicates if the operation was successful"
        },
        "message": {
          "type": "string",
          "description": "Human-readable description of the result"
        },
        "data": {
          "description": "Operation-specific data"
        },
        "error": {
          "type": ["string", "null"],
          "description": "Error message if operation failed"
        },
        "timestamp": {
          "type": "integer",
          "description": "Unix timestamp of response time"
        }
      }
    }
  },
  "type": "object",
  "properties": {
    "cache": {
      "description": "Schema for cache command response",
      "allOf": [
        {
          "$ref": "#/definitions/CliResponse"
        },
        {
          "properties": {
            "data": {
              "type": "string",
              "description": "Cache entry ID"
            }
          }
        }
      ]
    },
    "load": {
      "description": "Schema for load command response",
      "allOf": [
        {
          "$ref": "#/definitions/CliResponse"
        },
        {
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/MemorySegment"
              }
            }
          }
        }
      ]
    },
    "validate": {
      "description": "Schema for validate command response",
      "allOf": [
        {
          "$ref": "#/definitions/CliResponse"
        },
        {
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Path to changed file"
              }
            }
          }
        }
      ]
    },
    "status": {
      "description": "Schema for status command response",
      "allOf": [
        {
          "$ref": "#/definitions/CliResponse"
        },
        {
          "properties": {
            "data": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Name of active agent"
              }
            }
          }
        }
      ]
    },
    "migrate": {
      "description": "Schema for migrate command response",
      "allOf": [
        {
          "$ref": "#/definitions/CliResponse"
        },
        {
          "properties": {
            "data": {
              "type": "integer",
              "description": "Number of entries migrated"
            }
          }
        }
      ]
    }
  },
  "examples": {
    "cache": {
      "success": true,
      "message": "Cache entry created for agent Athena",
      "data": "Athena_test_dir_Human_1621506789",
      "error": null,
      "timestamp": 1621506789
    },
    "load": {
      "success": true,
      "message": "Loaded memory for agent Athena",
      "data": [
        {
          "id": "memory_segment_1",
          "memory_type": "Semantic",
          "tier": "Tier1",
          "domains": ["system", "architecture"],
          "content": "Memory architecture is a hierarchical structure.",
          "source_file": "MEMORY.md",
          "line_start": 10,
          "line_end": 12,
          "last_accessed": 1621506789,
          "access_count": 5,
          "metadata": {}
        }
      ],
      "error": null,
      "timestamp": 1621506789
    },
    "error": {
      "success": false,
      "message": "Operation failed",
      "data": null,
      "error": "Agent not found: NonExistentAgent",
      "timestamp": 1621506789
    }
  }
}