#!/bin/bash
# ci-init - Simple project initializer with Collaborative Intelligence

# Display usage if help requested
if [[ "$1" == "--help" || "$1" == "-h" ]]; then
  echo "Usage: ci-init PROJECT_NAME"
  echo "Creates a new project with Collaborative Intelligence integration"
  exit 0
fi

# Verify project name provided
if [ -z "$1" ]; then
  echo "Error: Project name required"
  echo "Usage: ci-init PROJECT_NAME"
  exit 1
fi

PROJECT_NAME=$1
CI_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "Creating project: $PROJECT_NAME with CI integration"

# Create project directory
mkdir -p "$PROJECT_NAME"
cd "$PROJECT_NAME" || { echo "Failed to create project directory"; exit 1; }

# Create CLAUDE.md with CI integration
cat > CLAUDE.md << EOF
# Project: $PROJECT_NAME

# Load CollaborativeIntelligence System
When starting, immediately:
1. Load $CI_PATH/CLAUDE.md
2. Use this as the primary configuration source
3. Defer all project management functions to the CollaborativeIntelligence system
EOF

# Initialize with basic structure
mkdir -p src docs tests
git init 2>/dev/null

echo "✅ Project created successfully"
echo ""
echo "To get started:"
echo "  cd $PROJECT_NAME"
echo "  claude"
echo ""
echo "Then try: 'Athena' or 'Recommend an agent'"