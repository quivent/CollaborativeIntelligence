#!/bin/bash
# ci-verify - Verify Collaborative Intelligence integration actually works

# Define color codes
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get absolute path to CI system, regardless of how the script is invoked
CI_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "Verifying Collaborative Intelligence integration..."
echo "CI Repository: $CI_PATH"

# Verify that required files exist
if [ ! -f "$CI_PATH/CLAUDE.md" ]; then
  echo -e "${RED}✘ Core CLAUDE.md file not found at $CI_PATH/CLAUDE.md${NC}"
  echo "Integration incomplete - missing core configuration"
  exit 1
fi

# Check for Claude CLI
if ! command -v claude &> /dev/null; then
  echo -e "${RED}✘ Claude CLI is not installed or not in PATH${NC}"
  echo "Please install Claude CLI first"
  exit 1
fi

# Create a temporary test file to verify integration
TEMP_FILE=$(mktemp)
cat > "$TEMP_FILE" << EOT
Hello Athena, confirm that the Collaborative Intelligence system is integrated.
Please respond with "INTEGRATION_VERIFIED" if successful.
EOT

echo "Running verification test..." 

# Run Claude with the test input and capture output
OUTPUT=$(claude < "$TEMP_FILE" 2>/dev/null | grep -E "\[Athena\]|INTEGRATION_VERIFIED")

# Clean up temp file
rm "$TEMP_FILE"

# Check if verification phrase is present
if echo "$OUTPUT" | grep -q "INTEGRATION_VERIFIED"; then
  echo -e "${GREEN}✓ Integration verified! Claude Code successfully connected to CI system${NC}"
  exit 0
elif echo "$OUTPUT" | grep -q "\[Athena\]"; then
  echo -e "${YELLOW}⚠ Partial integration detected - Athena agent responds but verification incomplete${NC}"
  echo "Output received: $OUTPUT"
  exit 1
else
  echo -e "${RED}✘ Integration verification failed${NC}"
  echo "Claude responded but didn't recognize CI system or Athena agent"
  echo "Output: $OUTPUT"
  exit 1
fi