#!/bin/bash
# ci-fix - Fix Collaborative Intelligence verify command issue

# Define color codes
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get absolute path to CI system, regardless of how the script is invoked
CI_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "Fixing CI verification command issue..."

# Create a patched version of ci-verify that includes timeout
VERIFY_SCRIPT="$CI_PATH/ci-verify"

# Check if the verify script exists
if [ ! -f "$VERIFY_SCRIPT" ]; then
  echo -e "${RED}✘ Cannot find ci-verify script at $VERIFY_SCRIPT${NC}"
  exit 1
fi

# Create a backup of the original script
cp "$VERIFY_SCRIPT" "${VERIFY_SCRIPT}.bak"
echo -e "${GREEN}✓ Created backup of original script at ${VERIFY_SCRIPT}.bak${NC}"

# Replace the problematic command in ci-verify
sed -i.bak '40s|OUTPUT=\$(claude < "$TEMP_FILE" 2>/dev/null | grep -E "\\[Athena\\]|INTEGRATION_VERIFIED")|# Set a timeout for the claude command (10 seconds)\nOUTPUT=$(timeout 10 claude < "$TEMP_FILE" 2>/dev/null | grep -E "\\[Athena\\]|INTEGRATION_VERIFIED" || echo "TIMEOUT")|' "$VERIFY_SCRIPT"

# Add timeout handling
sed -i.bak2 '46i\
# Check if the command timed out\
if echo "$OUTPUT" | grep -q "TIMEOUT"; then\
  echo -e "${RED}✘ Verification timed out after 10 seconds${NC}"\
  echo "The claude command is not responding in a timely manner."\
  echo "Possible issues:"\
  echo "  - Claude CLI may be stuck or incorrectly installed"\
  echo "  - CLAUDE.md configuration might be causing infinite processing"\
  echo ""\
  echo "To fix this issue:"\
  echo "  1. Try killing any stuck claude processes: killall claude"\
  echo "  2. Check your CLAUDE.md for circular references"\
  echo "  3. Run 'claude --version' to verify your CLI installation"\
  exit 1\
fi' "$VERIFY_SCRIPT"

# Also fix the CI tool verify command if it exists
CI_TOOL="$CI_PATH/ci-tools/CI"
if [ -f "$CI_TOOL" ]; then
  cp "$CI_TOOL" "${CI_TOOL}.bak"
  echo -e "${GREEN}✓ Created backup of original CI tool at ${CI_TOOL}.bak${NC}"
  
  # Replace the problematic command in CI tool
  sed -i.bak '117s|(cd "$TARGET_DIR" && OUTPUT=\$(claude < "$TEMP_FILE" 2>/dev/null | grep -E "\\[Athena\\]|INTEGRATION_VERIFIED"))|(cd "$TARGET_DIR" && OUTPUT=$(timeout 10 claude < "$TEMP_FILE" 2>/dev/null | grep -E "\\[Athena\\]|INTEGRATION_VERIFIED" || echo "TIMEOUT"))|' "$CI_TOOL"
  
  # Add timeout handling
  sed -i.bak2 '122i\
    # Check if the command timed out\
    if echo "$OUTPUT" | grep -q "TIMEOUT"; then\
      echo -e "${RED}✘ Verification timed out after 10 seconds${NC}"\
      echo "The claude command is not responding in a timely manner."\
      echo "Possible issues:"\
      echo "  - Claude CLI may be stuck or incorrectly installed"\
      echo "  - CLAUDE.md configuration might be causing infinite processing"\
      echo ""\
      echo "To fix this issue:"\
      echo "  1. Try killing any stuck claude processes: killall claude"\
      echo "  2. Check your CLAUDE.md for circular references"\
      echo "  3. Run 'claude --version' to verify your CLI installation"\
      exit 1\
    fi' "$CI_TOOL"
    
  echo -e "${GREEN}✓ Patched CI tool verify command${NC}"
fi

echo -e "${GREEN}✓ Successfully fixed CI verify command${NC}"
echo ""
echo "The fix adds a 10-second timeout to prevent hanging and provides better error messages."
echo "If you continue to have issues, try killing stuck claude processes with: killall claude"
echo ""
echo "To verify the fix worked, run: chmod +x ci-fix && ./ci-fix && ./ci-verify"

# Make the script executable
chmod +x "$VERIFY_SCRIPT"

echo -e "${YELLOW}Fixed script is ready to use${NC}"