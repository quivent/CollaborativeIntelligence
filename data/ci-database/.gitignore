# CI Database .gitignore

# SQLite database files
*.db
*.db-journal
*.db-wal
*.db-shm

# Backup files
backups/*.sql
backups/*.tar.gz

# Log files
logs/*.log

# Temporary files
*.tmp
*.temp

# Rust build artifacts
/target/
target/
**/*.rs.bk
**/*.o
**/*.a
**/*.so
**/*.dylib

# Keep directory structure
!*/
!.gitignore
!README.md